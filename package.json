{
	"name": "executors",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.11.2",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@all1ndev/prettier-config": "^2.0.0",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10"
	},
	"scripts": {
		"prepare": "husky"
	},
	"prettier": "@all1ndev/prettier-config",
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	}
}
